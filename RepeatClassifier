#
# Evidence recording ( -evidence <prefix> )
#
# With the flag set, RepeatClassifier records why it made each call and
# writes the result at the end of the run as <prefix>.tsv ( one row per
# family ) and <prefix>.json ( full detail ).  Without the flag these
# hooks write nothing.
#
# %EVIDENCE, keyed by query id:
#   protein  : { hits => [ { subject, class, beg, end, orient, score,
#                            identical, aligned, positives, p }, ... ],
#                best_p   => #,
#                resolved => { class, orient, p },
#                clashes  => [ { kept, dropped, rule }, ... ] }
#   dna      : { buckets => [ { class, orient, combined_score }, ... ] }
#   decision : { rule => <id>, explanations => [ ... ] }
#   final    : { class, orient }
#
my %EVIDENCE;
my %EVIDENCE_LAST_DECISION;
my $EVIDENCE_PREFIX = $options{'evidence'};
my $EVIDENCE_ON =
    ( defined $EVIDENCE_PREFIX && $EVIDENCE_PREFIX ne "" ) ? 1 : 0;

#
# BLAST prints "Expect = 0.0, Method: ..." so blastxAnalysis() can capture
# a p value with a trailing comma.  Perl coerces that to a number in the
# classifier's own comparisons, but the evidence files should hold a real
# number.  Returns undef for anything that does not start with one.
#
sub evidence_num {
  my ( $value ) = @_;
  return undef if ( !defined $value );
  return undef
      if ( $value !~ /^\s*([-+]?(?:\d+\.?\d*|\.\d+)(?:[eE][-+]?\d+)?)/ );
  return $1 + 0;
}

sub evidence_begin_query {
  my ( $q ) = @_;
  return if ( !$EVIDENCE_ON || !defined $q );
  $EVIDENCE{$q} ||= {};
  $EVIDENCE{$q}->{'protein'} ||=
      { 'hits' => [], 'best_p' => undef, 'clashes' => [] };
}

sub evidence_protein_add_hit {
  my ( $q, $hit ) = @_;
  return if ( !$EVIDENCE_ON );
  &evidence_begin_query( $q );
  $hit->{'p'} = &evidence_num( $hit->{'p'} );
  push @{ $EVIDENCE{$q}->{'protein'}->{'hits'} }, $hit;
  if ( defined $hit->{'p'} ) {
    my $bestP = $EVIDENCE{$q}->{'protein'}->{'best_p'};
    $EVIDENCE{$q}->{'protein'}->{'best_p'} = $hit->{'p'}
        if ( !defined $bestP || $hit->{'p'} < $bestP );
  }
}

#
# Record how chooseBestBlastX() settled a clash between two protein
# classes, and which rule did it.
#
sub evidence_protein_add_clash {
  my ( $q, $kept, $dropped, $rule ) = @_;
  return if ( !$EVIDENCE_ON );
  &evidence_begin_query( $q );
  push @{ $EVIDENCE{$q}->{'protein'}->{'clashes'} },
      { 'kept' => $kept, 'dropped' => $dropped, 'rule' => $rule };
}

#
# The class chooseBestBlastX() settled on, rather than the individual
# hits that fed it.
#
sub evidence_protein_set_resolved {
  my ( $q, $class, $orient, $pVal ) = @_;
  return if ( !$EVIDENCE_ON );
  &evidence_begin_query( $q );
  $EVIDENCE{$q}->{'protein'}->{'resolved'} =
      { 'class'  => $class,
        'orient' => $orient,
        'p'      => &evidence_num( $pVal ) };
}

sub evidence_dna_set_buckets {
  my ( $q, $buckets ) = @_;
  return if ( !$EVIDENCE_ON );
  $EVIDENCE{$q} ||= {};
  $EVIDENCE{$q}->{'dna'} = { 'buckets' => $buckets };
}

sub evidence_set_final {
  my ( $q, $class, $orient ) = @_;
  return if ( !$EVIDENCE_ON );
  $EVIDENCE{$q} ||= {};
  $EVIDENCE{$q}->{'final'} = { 'class' => $class, 'orient' => $orient };
}

#
# conflictsolver() calls matchprotanddnaclass() once per candidate DNA
# match and then a final time for the pick, so matchprotanddnaclass()
# stashes its reasoning here instead of filing it directly.
# conflictsolver() commits the stash after that final call, where it has
# the query name in hand rather than recovering it from the key.
#
sub evidence_stash_decision {
  my ( $rule, $why ) = @_;
  return if ( !$EVIDENCE_ON );
  %EVIDENCE_LAST_DECISION = ( 'rule' => $rule, 'explanations' => $why );
}

sub evidence_commit_decision {
  my ( $q ) = @_;
  return if ( !$EVIDENCE_ON || !defined $q );
  $EVIDENCE{$q} ||= {};
  $EVIDENCE{$q}->{'decision'} = {
                        'rule' => $EVIDENCE_LAST_DECISION{'rule'} // "",
                        'explanations' =>
                            $EVIDENCE_LAST_DECISION{'explanations'} || [] };
  %EVIDENCE_LAST_DECISION = ();
}

#
# Gather the combined-score buckets belonging to one query.  Keys of
# %combscore are "query#class#orientation", and a query id can itself
# contain a "#" under -preserve_class, so match the known prefix instead
# of splitting the whole key.
#
sub evidence_buckets_for {
  my ( $q, $combScoreRef ) = @_;
  my @buckets = ();
  my $prefix  = $q . "#";
  foreach my $key ( keys %{$combScoreRef} ) {
    next if ( index( $key, $prefix ) != 0 );
    my ( $class, $orient ) =
        split /\#/, substr( $key, length( $prefix ) ), 2;
    push @buckets, { 'class'          => $class,
                     'orient'         => $orient,
                     'combined_score' => $combScoreRef->{$key} };
  }
  return [ sort { $b->{'combined_score'} <=> $a->{'combined_score'} }
           @buckets ];
}

sub evidence_write_files {
  return if ( !$EVIDENCE_ON );

  # Core since 5.14, and only needed when the flag is given.
  require JSON::PP;

  my $tsvFile  = $EVIDENCE_PREFIX . ".tsv";
  my $jsonFile = $EVIDENCE_PREFIX . ".json";

  open my $TSV, ">", $tsvFile
      or die $CLASS . ": Could not open $tsvFile for writing!\n";
  print $TSV join( "\t",
                   qw( query_id final_class final_orient protein_class
                       protein_orient protein_best_p dna_best_class
                       dna_best_orient dna_best_score decision_rule
                       notes ) )
      . "\n";

  my @records = ();
  foreach my $q ( sort keys %EVIDENCE ) {
    my $rec      = $EVIDENCE{$q};
    my $protein  = $rec->{'protein'}  || {};
    my $dna      = $rec->{'dna'}      || {};
    my $decision = $rec->{'decision'} || {};
    my $final    = $rec->{'final'}    || {};

    my ( $dnaClass, $dnaOrient, $dnaScore ) = ( "", "", "" );
    if ( $dna->{'buckets'} && @{ $dna->{'buckets'} } ) {
      my $top = $dna->{'buckets'}->[ 0 ];
      $dnaClass  = $top->{'class'}          // "";
      $dnaOrient = $top->{'orient'}         // "";
      $dnaScore  = $top->{'combined_score'} // "";
    }

    # The resolved class, not the first hit that came in.
    my $resolved = $protein->{'resolved'} || {};

    print $TSV join( "\t",
                     $q,
                     $final->{'class'}    // "",
                     $final->{'orient'}   // "",
                     $resolved->{'class'} // "",
                     $resolved->{'orient'} // "",
                     $protein->{'best_p'} // "",
                     $dnaClass,
                     $dnaOrient,
                     $dnaScore,
                     $decision->{'rule'} // "",
                     ( $decision->{'explanations'}
                       ? join( "; ", @{ $decision->{'explanations'} } )
                       : "" ) )
        . "\n";

    push @records, { 'family'   => $q,
                     'final'    => $final,
                     'protein'  => $protein,
                     'dna'      => $dna,
                     'decision' => $decision };
  }
  close $TSV;

  # One JSON document rather than a run of concatenated objects, with
  # canonical key order so you can diff two runs against each other.
  open my $JSON, ">", $jsonFile
      or die $CLASS . ": Could not open $jsonFile for writing!\n";
  print $JSON JSON::PP->new->ascii->pretty->canonical->encode(
                                       { 'version'  => $version,
                                         'families' => \@records } );
  close $JSON;

  print "Classification evidence written to $tsvFile and $jsonFile\n";
}

#
# nail prototype: locations of the nail and MMseqs2 programs, and the
