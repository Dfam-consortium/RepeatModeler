  $MMSEQS_PRGM = `which mmseqs 2>/dev/null`;
  chomp $MMSEQS_PRGM;
}
my $nailSensitivity = 10;
$nailSensitivity = $options{'nail_sensitivity'}
    if ( defined $options{'nail_sensitivity'} );
die $CLASS . ": Could not find the nail program ( looked for $NAIL_PRGM ).\n"
    . "Use -nail_dir or set NAIL_DIR.\n"
    unless ( -x $NAIL_PRGM );
die $CLASS . ": Could not find the mmseqs program, which nail requires.\n"
    . "Use -mmseqs or set MMSEQS_PRGM.\n"
    unless ( $MMSEQS_PRGM && -x $MMSEQS_PRGM );

my $cmdSuffix = "> /dev/null 2>&1";
$cmdSuffix = "" if ( $DEBUG );

