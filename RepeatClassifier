      or die "Could not open up stockholm file $infile for reading!\n";
  $stockholmFile->read_stockholm( $IN );
  close $IN;

  for ( my $i = 0 ; $i < $stockholmFile->size() ; $i++ ) {
    my $seedAlign   = $stockholmFile->get( $i );
    my $id          = $seedAlign->getId();
    my $sanitizedID = $id;
    $sanitizedID = $1 if ( $id =~ /^([^\#]+)\#.*$/ );
    unless (    $preserve_class
             && $sanitizedID ne $id )
    {
      my $className = $class{$sanitizedID};
      $className = "Unknown" if ( $className eq "" );
      if ( defined $simpleRepeatsRef->{$id} ) {
        $className = "Simple_repeat";
      }
      my $dfamClass = "";
      if ( defined $rmToDfamClass{ lc( $className ) } ) {
        $dfamClass = $rmToDfamClass{ lc( $className ) };
      }
      $seedAlign->setClassification( $dfamClass );
      if ( defined $ori{$id}
           && $ori{$id} eq "Minus" )
      {
        $seedAlign->reverseComplementAlignment();
      }
    }
    print OUT "" . $seedAlign->toString();
  }
}

##
## Locate pre-built FamDB reference libraries or build them on first use.
## Search order: <install>/Libraries, ~/.RepeatModelerCache, <input_file_dir>.
## Dies if no writable location can be found or the build fails everywhere.
##
sub resolve_reference_libraries {
  my ( $famdb_dir, $version, $searchEngine, $input_file ) = @_;

  my $prot_label = "PROT-Dfam_$version";
  my $cons_label = "CONS-Dfam_$version";

  my @candidates = (
    "$FindBin::RealBin/Libraries",
    "$ENV{HOME}/.RepeatModelerCache",
  );
  push @candidates, dirname( Cwd::abs_path( $input_file ) ) if $input_file;

  for my $base ( @candidates ) {
    my $prot_lib = "$base/$prot_label/repeatpeps.lib";
    my $cons_lib = "$base/$cons_label/reference.fa";

    # nail searches the protein FASTA as it is, so a library the blastx
    # classifier built, with its .p* index beside it, works here too.
    return ( $prot_lib, $cons_lib )
        if -s $prot_lib && $searchEngine->isSubjectPrepared( $cons_lib );

    next unless _can_write_dir( $base );

    print "\nBuilding FamDB $version reference libraries (one-time step)...\n";
    print "  Location: $base\n";
    if ( _build_reference_libraries( $famdb_dir, $searchEngine,
                                     "$base/$prot_label",
                                     "$base/$cons_label" ) ) {
      return ( $prot_lib, $cons_lib );
    }
  }

  die "$CLASS: Could not find or build FamDB $version reference libraries.\n"
      . "  Searched:\n"
      . join( "", map { "    $_\n" } @candidates );
}

sub _can_write_dir {
  my $dir = shift;
  unless ( -d $dir ) {
    eval { make_path($dir) };
    return 0 if $@;
  }
  if ( open my $fh, '>', "$dir/.rmwritetest" ) {
    close $fh;
    unlink "$dir/.rmwritetest";
    return 1;
  }
  return 0;
}

sub _build_reference_libraries {
  my ( $famdb_dir, $searchEngine, $prot_dir, $cons_dir ) = @_;

  for my $dir ( $prot_dir, $cons_dir ) {
    eval { make_path($dir) };
    if ( $@ || !-d $dir ) {
      warn "  Could not create $dir\n";
      return 0;
    }
  }

  print "  Extracting RepeatPeps from FamDB...\n";
  system("$famdb_dir/famdb.py repeat_peps > \"$prot_dir/repeatpeps.lib\" 2>/dev/null");
  unless ( -s "$prot_dir/repeatpeps.lib" ) {
    rmtree($prot_dir);
    warn "  Failed to extract RepeatPeps from FamDB.\n";
    return 0;
  }

  print "  Extracting consensus sequences from FamDB...\n";
  system("$famdb_dir/famdb.py fasta_all > \"$cons_dir/reference.fa\" 2>/dev/null");
  unless ( -s "$cons_dir/reference.fa" ) {
    rmtree($cons_dir);
    warn "  Failed to extract consensus sequences from FamDB.\n";
    return 0;
  }

  print "  Preparing consensus library for the search engine...\n";
  my $prepared = eval {
    $searchEngine->prepareSubject( "$cons_dir/reference.fa", dbVersion => 4 );
  };
  unless ( $prepared && $searchEngine->isSubjectPrepared( $prepared ) ) {
    rmtree($cons_dir);
    warn "  Failed to prepare the consensus library: $@\n";
    return 0;
  }

  print "  Done.\n";
  return 1;
}


##---------------------------------------------------------------------##
## Use: my $numORFs = &sixFrameTranslate( $inFile, $outFile, $minLen );
##
##      Translate each sequence in $inFile in all six frames, writing
##      the peptides of each frame ( split at X runs of 10 or more,
##      keeping pieces of at least $minLen residues ) to $outFile.
##      Stop codons and ambiguous codons are emitted as 'X'.
##      The peptide identifiers encode what is needed to map alignment
##      coordinates back to the DNA:
##
##          <seqID>|<strand><frame>|<dnaStart>-<dnaEnd>
##
##      where dnaStart/dnaEnd are the 1-based forward-strand bounds of
##      the translated frame.  Returns the number of peptides written.
##---------------------------------------------------------------------##
sub sixFrameTranslate {
  my ( $inFile, $outFile, $minLen ) = @_;

  my %codonTable;
  {
    my @bases = qw( T C A G );
    my $aas =
        "FFLLSSSSYY**CC*WLLLLPPPPHHQQRRRRIIIMTTTTNNKKSSRRVVVVAAAADDEEGGGG";
    my $i = 0;
    for my $b1 ( @bases ) {
      for my $b2 ( @bases ) {
        for my $b3 ( @bases ) {
          $codonTable{"$b1$b2$b3"} = substr( $aas, $i++, 1 );
        }
      }
    }
  }

  open SFIN, "<$inFile"
      or die $CLASS . "::sixFrameTranslate(): Could not open $inFile!\n";
  open SFOUT, ">$outFile"
      or die $CLASS . "::sixFrameTranslate(): Could not open $outFile!\n";

  my $numORFs = 0;
  my $procSeq = sub {
    my ( $id, $dna ) = @_;
    return unless ( defined $id && $dna );
    my $seqLen = length $dna;
    for my $strand ( '+', '-' ) {
      my $s = $dna;
      if ( $strand eq '-' ) {
        $s = reverse $s;
        $s =~ tr/ACGT/TGCA/;
      }
      for my $f ( 0 .. 2 ) {
        my $prot = "";
        for ( my $i = $f ; $i + 2 < $seqLen ; $i += 3 ) {
          $prot .= $codonTable{ substr( $s, $i, 3 ) } // 'X';
        }
        $prot =~ tr/*/X/;

        # A long X run comes from masked DNA and cannot contribute to
        # an alignment, but nail has no equivalent of the seg filter
        # blastx applies and will chain marginal alignments across it.
        # Split there; single stops and short masked stretches remain
        # so that alignments can still extend through them.
        my $aaOffset = 0;
        for my $seg ( split( /(X{10,})/, $prot ) ) {
          my $segLen = length( $seg );
          if ( $seg !~ /^X{10,}$/ && $segLen >= $minLen ) {
            my ( $beg, $end ) =
                ( $f + 1 + 3 * $aaOffset, $f + 3 * ( $aaOffset + $segLen ) );
            ( $beg, $end ) = ( $seqLen - $end + 1, $seqLen - $beg + 1 )
                if ( $strand eq '-' );
            print SFOUT ">$id|$strand" . ( $f + 1 ) . "|$beg-$end\n$seg\n";
            $numORFs++;
          }
          $aaOffset += $segLen;
        }
      }
    }
  };

  my ( $id, $seq );
  while ( <SFIN> ) {
    chomp;
    if ( /^>(\S+)/ ) {
      $procSeq->( $id, $seq );
      $id  = $1;
      $seq = "";
    }
    else {
      $seq .= uc $_;
    }
  }
  $procSeq->( $id, $seq );
  close SFIN;
  close SFOUT;

  return $numORFs;
}

##---------------------------------------------------------------------##
## Use: my $pValuesRef = &nailAnalysis( fileName => "",
##                                      pValueCutoff => #,
##                                      masklevel => # );
##
##      fileName : nail "--tbl-format blast" tabular results from
##                 searching the six-frame translated consensi
##                 against the TE protein library.
##
##      The counterpart of blastxAnalysis for nail results.  Hits are
##      aggregated per consensus/protein pair ( merging HSPs from
##      different frames, as the blastx parser does ), peptide
##      coordinates are mapped back to consensus DNA coordinates, and
##      each consensus hit set is passed to chooseBestBlastX.
##---------------------------------------------------------------------##
sub nailAnalysis {
  my %parameters = @_;

  die $CLASS . "::nailAnalysis(): Bad or missing fileName parameter!"
      if ( !defined $parameters{'fileName'} || !-e $parameters{'fileName'} );
  my $summaryfile = $parameters{'fileName'} . ".bxsummary";

  die $CLASS . "::nailAnalysis(): Missing pValueCutoff parameter!"
      if ( !defined $parameters{'pValueCutoff'} );
  my $cutoffP = $parameters{'pValueCutoff'};

  die $CLASS . "::nailAnalysis(): Missing masklevel parameter!"
      if ( !defined $parameters{'masklevel'} );
  my $masklevel = $parameters{'masklevel'};

  open NLTP, "<$parameters{'fileName'}"
      or die $CLASS
      . "::nailAnalysis(): Could not open file $parameters{'fileName'}!\n";
  open SUMR, ">$summaryfile"
      or die "Could not open summary file $summaryfile for writing!\n";

  # %hits{ query }{ subject } accumulates the same per-subject record
  # that blastxAnalysis builds ( see its comments ), plus each query's
  # 'oppositestrand' flag.
  my %hits;
  my %opposite;

  while ( <NLTP> ) {
    next if ( /^#/ || !/\S/ );
    my ( $qfull, $sbjct, $pid, $alnLen, $mismatch, $gapOpen,
         $qStart, $qEnd, $sStart, $sEnd, $eVal, $score ) = split;
    next unless ( defined $score );
    $eVal = "1$eVal" if ( $eVal =~ /^e/ );
    next if ( $eVal > $cutoffP );

    # Decode the DNA mapping from the peptide identifier
    my ( $query, $strandFrame, $frameRange ) = split( /\|/, $qfull );
    my ( $strand ) = $strandFrame =~ /^([+-])/;
    my ( $frameBeg, $frameEnd ) = split( /-/, $frameRange );
    my ( $beg, $end );
    if ( $strand eq '+' ) {
      $beg = $frameBeg + 3 * ( $qStart - 1 );
      $end = $frameBeg + 3 * $qEnd - 1;
    }
    else {
      $end = $frameEnd - 3 * ( $qStart - 1 );
      $beg = $frameEnd - 3 * $qEnd + 1;
    }
    my $orient = ( $strand eq '+' ) ? "Plus" : "Minus";

    $opposite{$query} = 1 if ( $sbjct =~ /\#ReverseORF/ );

    my $identical = sprintf( "%.0f", $pid * $alnLen / 100 );
    my $rec = $hits{$query}{$sbjct};
    if ( !defined $rec ) {
      $hits{$query}{$sbjct} = {
                                'beg'       => $beg,
                                'end'       => $end,
                                'or'        => $orient,
                                'p'         => $eVal,
                                'score'     => $score,
                                'identical' => $identical,
                                'aligned'   => $alnLen,
                                'positives' => $identical,
                                'oppositestrand' =>
                                    ( $sbjct =~ /\#ReverseORF/ ) ? 1 : 0
      };
    }
    else {
      # Orientation follows the highest-scoring HSP
      $rec->{'or'}    = $orient if ( $score > $rec->{'score'} );
      $rec->{'score'} = $score if ( $score > $rec->{'score'} );
      $rec->{'p'}     = $eVal if ( $eVal < $rec->{'p'} );
      $rec->{'beg'}   = $beg if ( $beg < $rec->{'beg'} );
      $rec->{'end'}   = $end if ( $end > $rec->{'end'} );
      $rec->{'identical'} += $identical;
      $rec->{'aligned'}   += $alnLen;
      $rec->{'positives'} += $identical;
    }
  }
  close NLTP;

  my %bxResults = ();
  foreach my $query ( sort keys %hits ) {
    my %queryHits = %{ $hits{$query} };
    $queryHits{'query'}          = $query;
    $queryHits{'oppositestrand'} = $opposite{$query} || 0;
    my ( $class, $orient, $pVal ) = &chooseBestBlastX(
                                                   queryHits => \%queryHits,
                                                   masklevel => $masklevel
    );
    $bxResults{$query} = {
                           'class'  => $class,
                           'orient' => $orient,
                           'pVal'   => $pVal
    };
  }

  return ( \%bxResults );
}

1;
