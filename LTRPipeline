#
# Module Dependence
#
use strict;
use Getopt::Long;
use Pod::Text;
use File::Path;
use File::Basename;
use File::Spec;
use FindBin;
use Cwd;
use lib $FindBin::RealBin;
use RepModelConfig;

my $DEBUG = 0;
$DEBUG = 1 if ( $RepModelConfig::DEBUGALL == 1 );
$| = 1;    # Turn autoflush on

my $version = $RepModelConfig::VERSION;

#
# Option processing
#
my @getopt_args = (
                    '-version',
                    '-tmpdir=s',
                    '-debug',
                    '-giToID=s',
                    '-threads=i',
                    '-ltr_hmm=s',
                    '-LTRMaxSeqLen=i',    # obsolete; accepted and ignored
);

# Add configuration parameters as additional command-line options
push @getopt_args, RepModelConfig::getCommandLineOptions();

my %options = ();
Getopt::Long::config( "noignorecase", "bundling_override" );
unless ( GetOptions( \%options, @getopt_args ) ) {
  usage();
}

$DEBUG = 1 if ( exists $options{'debug'} );

#
# Provide the POD text from this file and from the config file by merging
# them together.  The heading "CONFIGURATION OVERRIDES" provides the
# insertion point for the configuration POD.
#
sub usage {
  my $p = Pod::Text->new();
  $p->output_fh( *STDOUT );
  my $pod_str;
  open IN, "<$0"
      or die "Could not open self ($0) for generating documentation!";
  while ( <IN> ) {
    if ( /^=head1\s+CONFIGURATION OVERRIDES\s*$/ ) {
      my $c_pod = RepModelConfig::getPOD();
      $pod_str .= $_ . $c_pod if ( $c_pod );
    }
    else {
      $pod_str .= $_;
    }
  }
  close IN;
  print "$0 - $version\n";
  $p->parse_string_document( $pod_str );
  exit( 1 );
}

if ( $options{'version'} ) {
  print "$version\n";
  exit;
}

#
# Resolve configuration settings using the following precedence:
# command line first, then environment, followed by config file.
#
RepModelConfig::resolveConfiguration( \%options );
my $config = $RepModelConfig::configuration;

unless ( -s $ARGV[ 0 ] ) {
  usage();
}
my $inputFile = $ARGV[ 0 ];

print "LTRPipeline: -LTRMaxSeqLen is obsolete and ignored.\n"
    if ( $options{'LTRMaxSeqLen'} );

#
# Dependencies
#
foreach my $param ( "LTR_FORAGE_DIR", "SUFR_DIR", "TE_COMPOSER_DIR", "NAIL_DIR" ) {
  if ( !RepModelConfig::validateParam( $param ) ) {
    die "LTRPipeline: $param is missing or incorrectly set ( '"
        . ( $config->{$param}->{'value'} // "" ) . "' ).\n"
        . "             Rerun ./configure or set it on the command line.\n";
  }
}
my $forageDir = $config->{'LTR_FORAGE_DIR'}->{'value'};
my $sufrDir   = $config->{'SUFR_DIR'}->{'value'};

# ltr-forage 0.2.0 reads sufr 0.8.0's index format and writes the output
# layout convertLibrary() expects; ltr_library.py checks sufr's version.
my $forageVersion = RepModelConfig::getDependencyVersion( "LTR_FORAGE_DIR" ) // "";
my @fv = split( /\./, $forageVersion );
die "LTRPipeline: ltr-forage in $forageDir is version "
    . ( $forageVersion || "unknown" ) . "; 0.2.0 or higher is needed.\n"
    if ( @fv != 3 || $fv[ 0 ] == 0 && $fv[ 1 ] < 2 );
my $mmseqs    = RepModelConfig::findMMseqs()
    or die "LTRPipeline: Could not find mmseqs in MMSEQS_DIR or on the PATH.\n";

# ltr_library.py beside the binaries, in pipeline/, or for binaries in a
# cargo target/release directory, ../../pipeline
my $script;
foreach my $cand ( "$forageDir/ltr_library.py",
                   "$forageDir/pipeline/ltr_library.py",
                   "$forageDir/../../pipeline/ltr_library.py" ) {
  if ( -s $cand ) { $script = $cand; last; }
}
die "LTRPipeline: Could not find ltr_library.py in $forageDir, its pipeline/\n"
    . "             directory or $forageDir/../../pipeline.\n"
    if ( !$script );

my $ltrHmm = $options{'ltr_hmm'};
if ( $ltrHmm ) {
  die "LTRPipeline: The profile HMM file $ltrHmm is missing or empty.\n"
      if ( !-s $ltrHmm );
}

my $threads = $options{'threads'} || 1;

#
# Working directory
#
my $tempDir = &createTempDir(
                    [ ( $options{'tmpdir'} // dirname( $inputFile ) ), cwd() ],
                    "LTR" );
die "LTRPipeline: Could not create a working directory.\n" if ( !$tempDir );
my $outDir = "$tempDir/ltr_library";
my $log    = "$tempDir/ltr_library.log";

#
# Run ltr_library.py
#
my $startTime = time;
my $cmd = "python3 $script " . File::Spec->rel2abs( $inputFile )
    . " -o $outDir -t $threads"
    . " --ltr-forage $forageDir/ltr-forage --sufr-bin $sufrDir/sufr"
    . " --te-composer $config->{'TE_COMPOSER_DIR'}->{'value'}/te-composer"
    . " --nail $config->{'NAIL_DIR'}->{'value'}/nail --mmseqs $mmseqs";
$cmd .= " --domain-hmm $ltrHmm" if ( $ltrHmm );
$cmd .= " --keep-work" if ( $DEBUG );
my $rmblastn = "$config->{'RMBLAST_DIR'}->{'value'}/rmblastn";
if ( -x $rmblastn
     && `$rmblastn -version 2>&1` =~ /rmblastn\s+(\d+)\.(\d+)\.(\d+)/
     && ( $1 > 3 || ( $1 == 3 && ( $2 > 0 || $3 >= 9 ) ) ) ) {
  $cmd .= " --rmblastn $rmblastn";
}
$cmd .= " > $log 2>&1";

print "Running ltr-forage ( ltr_library.py )...";
print "\nLTRPipeline: Running $cmd\n" if ( $DEBUG );
if ( system( $cmd ) != 0 ) {
  die "\nLTRPipeline: ltr_library.py failed ( exit code " . ( $? >> 8 )
      . " ).  See $log\n"
      . "             and $outDir/run.log\n";
}

my $numModels = 0;
if ( -s "$outDir/library.fa" ) {
  die "\nLTRPipeline: ltr_library.py wrote no seed alignments ( $outDir/library.stk );\n"
      . "             it needs ltr-forage with step 23b.\n"
      if ( !-s "$outDir/library.stk" );
  $numModels = &convertLibrary( $outDir, $options{'giToID'}, "$inputFile-ltrs" );
}

if ( $numModels == 0 ) {
  print "\nLTRPipeline: No families built by ltr-forage.\n";
}
else {
  print " : $numModels family models, " . &elapsed( $startTime ) . "\n";
}
rmtree( $tempDir ) unless ( $DEBUG );
exit;

######################## S U B R O U T I N E S ############################

##-------------------------------------------------------------------------##
## Use: my $numModels = &convertLibrary( $outDir, $translationFile,
##                                       $outPrefix );
##
##   Rewrite ltr_library.py's library.fa/library.stk as RepeatModeler
##   families: $outPrefix.fa, $outPrefix.stk and $outPrefix.tsv ( see the
##   DESCRIPTION ).  Models are numbered in library order.  Returns the
##   number of models written.
##
##-------------------------------------------------------------------------##
sub convertLibrary {
  my ( $outDir, $translation, $outPrefix ) = @_;

  # gi-# ( as RepeatModeler writes the sequence file ) back to the
  # assembly's names
  my %giMap = ();
  if ( $translation && -s $translation ) {
    open my $TR, "<$translation"
        or die "LTRPipeline: Could not open $translation!\n";
    while ( <$TR> ) {
      $giMap{"gi-$2"} = $1 if ( /^(\S+)\t(\d+)/ );
    }
    close $TR;
  }

  # Records: >fam0001_v1_LTR#LTR/Gypsy origin=...
  my %newID = ();
  my $num   = 0;
  open my $IN, "<$outDir/library.fa"
      or die "LTRPipeline: Could not open $outDir/library.fa!\n";
  open my $FA, ">$outPrefix.fa"
      or die "LTRPipeline: Could not open $outPrefix.fa for writing!\n";
  open my $TSV, ">$outPrefix.tsv"
      or die "LTRPipeline: Could not open $outPrefix.tsv for writing!\n";
  while ( <$IN> ) {
    if ( /^>(\S+)/ ) {
      my ( $model, $class ) = split( /#/, $1, 2 );
      $class = "LTR" if ( !$class );
      my $kind = ( $model =~ /_INT$/ ? "INT" : "LTR" );
      $num++;
      $newID{$model} = "ltr-1_family-$num";
      print $FA ">ltr-1_family-$num [ Type=$kind, ltr-forage=$model, Class=$class ]\n";
      print $TSV "ltr-1_family-$num\t$model\t$class\t$kind\n";
      next;
    }
    print $FA $_;
  }
  close $IN;
  close $FA;
  close $TSV;

  open $IN, "<$outDir/library.stk"
      or die "LTRPipeline: Could not open $outDir/library.stk!\n";
  open my $STK, ">$outPrefix.stk"
      or die "LTRPipeline: Could not open $outPrefix.stk for writing!\n";
  while ( <$IN> ) {
    if ( /^#=GF\s+ID\s+(\S+)/ ) {
      my $model = $1;
      my $id    = $newID{$model}
          or die "LTRPipeline: $model in library.stk is not in library.fa!\n";
      print $STK "#=GF ID $id\n";
      print $STK "#=GF DE RepeatModeler Generated - $id\n";
      print $STK "#=GF CC LTR-Pipeline [ ltr-forage model $model ]\n";
      next;
    }
    if ( /^(gi-\d+)(:\S+)(\s+\S+\s*)$/ && exists $giMap{$1} ) {
      print $STK $giMap{$1} . $2 . $3;
      next;
    }
    print $STK $_;
  }
  close $IN;
  close $STK;

  return $num;
}

##-------------------------------------------------------------------------##
## Use: my $tempDir = &createTempDir( \@tmpPath, $prefix );
##
##   Create a writable directory $prefix_$PID.$DATE in the first of
##   @tmpPath that allows it.  Returns its path, or "" if none does.
##
##-------------------------------------------------------------------------##
sub createTempDir {
  my ( $tmpPathRef, $prefix ) = @_;

  # Windows does not support the use of ":" in a filename.
  my $date = localtime( time() );
  $date =~ s/[ ,\t,\n:]//g;
  my $runnumber = "$$" . ".$date";

  foreach my $directory ( @{$tmpPathRef} ) {
    $directory =~ s/\/$//;
    my $tempDir = "$directory/${prefix}_$runnumber";
    if ( -d $tempDir || mkdir $tempDir, 0777 ) {
      if ( open( my $T, ">$tempDir/deleteMe" ) ) {
        close $T;
        unlink( "$tempDir/deleteMe" );
        return $tempDir;
      }
    }
  }
  return "";
}

##-------------------------------------------------------------------------##
## Use: my $string = &elapsed( $startTime );
##
##   The time since $startTime as "hh:mm:ss (hh:mm:ss) Elapsed Time".
##
##-------------------------------------------------------------------------##
sub elapsed {
  my $secs = time - shift;
  return sprintf( "%02d:%02d:%02d (hh:mm:ss) Elapsed Time",
                  int( $secs / 3600 ), int( ( $secs % 3600 ) / 60 ),
                  $secs % 60 );
}
