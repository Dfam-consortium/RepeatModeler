## Configure TRF (required).
##
sub configure_trf {
  _configure_dir(
    key   => 'TRF_DIR',
    label => 'TRF',
    desc  => 'Tandem Repeat Finder identifies tandem repeats. '
           . 'The executable must be named "trf". (4.0.9 or higher)',
    url   => 'https://github.com/Benson-Genomics-Lab/TRF',
  );
}

##
## Configure nail and MMseqs2 (required).  RepeatClassifier runs nail for
## its protein search, and nail seeds with mmseqs.
##
sub configure_nail {
  _configure_dir(
    key   => 'NAIL_DIR',
    label => 'nail',
    desc  => 'RepeatClassifier searches the TE protein library with nail, '
           . 'in place of the NCBI blastx it once used.',
    url   => 'https://github.com/TravisWheelerLab/nail',
  );
  _configure_dir(
    key   => 'MMSEQS_DIR',
    label => 'MMseqs2',
    desc  => 'nail seeds its search with MMseqs2.  nail will absorb it in '
           . 'a future release, and this setting goes with it.',
    url   => 'https://github.com/soedinglab/MMseqs2',
    version_check => sub {
      my $val     = $config->{'MMSEQS_DIR'}->{'value'};
      my $problem = RepModelConfig::checkMMseqs("$val/mmseqs");
      die "\n  ERROR: $problem\n" if $problem;
      status_info("Test search ran on this machine");
    },
  );
}

##
## Configure UCSC TwoBit tools (required).
##
sub configure_ucsctools {
  _configure_dir(
    key   => 'UCSCTOOLS_DIR',
    label => 'UCSC TwoBit Tools',
    desc  => 'UCSC TwoBit tools (twoBitToFa, faToTwoBit, twoBitInfo) '
           . 'handle 2bit genome files.',
    url   => 'https://hgdownload.soe.ucsc.edu/admin/exe/',
  );
}

##
## Extract FamDB libraries and build BLAST databases in Libraries/.
## Called once at configure time so RepeatClassifier can rely on them.
##
## Print a final summary of the installed configuration.
##
sub print_summary {
  my $w = 62;
  print "\n" . "=" x $w . "\n";
  printf " %-*s\n", $w - 2, " Configuration Summary";
  print "=" x $w . "\n\n";

  my @core = (
    [ 'REPEATMASKER_DIR', 'RepeatMasker'   ],
    [ 'FAMDB_DIR',        'FamDB'          ],
    [ 'RMBLAST_DIR',      'RMBlast'        ],
    [ 'RSCOUT_DIR',       'RepeatScout'    ],
    [ 'RECON_DIR',        'RECON'          ],
    [ 'REPEATAFTERME_DIR','RepeatAfterMe'  ],
    [ 'DFAM_CURATOR_DIR', 'dfam-curator'   ],
    [ 'LTR_FORAGE_DIR',   'ltr-forage'     ],
    [ 'SUFR_DIR',         'sufr'           ],
    [ 'TRF_DIR',          'TRF'            ],
    [ 'UCSCTOOLS_DIR',    'UCSC TwoBit'    ],
  );

  for my $item ( @core ) {
    my ( $key, $label ) = @$item;
    my $val = $config->{$key}->{'value'} // "";
    if ( $val && RepModelConfig::validateParam($key) ) {
      printf "  %-16s  %s\n", "$label:", $val;
    }
    else {
      printf "  %-16s  (not configured)\n", "$label:";
    }
  }

  # FamDB database details from famdb.py info
  if ( RepModelConfig::validateParam('FAMDB_DIR') ) {
    my $famdb_dir = $config->{'FAMDB_DIR'}->{'value'};
    my $info = `$famdb_dir/famdb.py info 2>/dev/null` // "";
    if ( $info ) {
      my ( $db_name, $db_ver, $db_date, $db_count );
      $db_name  = $1 if $info =~ /^Database\s*:\s*(\S.*)/m;
      $db_ver   = $1 if $info =~ /^Version\s*:\s*(\S.*)/m;
      $db_date  = $1 if $info =~ /^Date\s*:\s*(\S.*)/m;
      $db_count = $1 if $info =~ /^Total consensus sequences present\s*:\s*(\d+)/m;
      $db_count = $1 if !$db_count && $info =~ /^Total HMMs present\s*:\s*(\d+)/m;
      if ( $db_name ) {
        printf "  %-16s  %s %s (%s)\n", "",
            $db_name, $db_ver // "", $db_date // "";
        printf "  %-16s  %s families\n", "",
            _commify($db_count) if $db_count;
      }
    }
  }

  print "\n" . "=" x $w . "\n";
  printf " %-*s\n", $w - 2, " RepeatModeler v$version is configured and ready.";
  print "=" x $w . "\n\n";
}

sub _commify {
  my $n = reverse( $_[0] // 0 );
  $n =~ s/(\d{3})(?=\d)/$1,/g;
  return scalar reverse $n;
}

1;
