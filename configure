##
## Configure ltr-forage and sufr (required), the LTR structural pipeline.
##
sub configure_ltr_forage {
  _configure_dir(
    key   => 'LTR_FORAGE_DIR',
    label => 'ltr-forage',
    desc  => 'ltr-forage finds LTR retrotransposons and builds their family '
           . 'library for the LTR structural pipeline (-LTRStruct). Give the '
           . 'directory holding the ltr-forage program: a release\'s bin/, or '
           . 'target/release of a source build. (0.2.0 or higher)',
    url   => 'https://github.com/Dfam-consortium/ltr-forage',
    version_check => sub { _check_version( 'LTR_FORAGE_DIR', 'ltr-forage', '0.2.0' ) },
  );
  _configure_dir(
    key   => 'SUFR_DIR',
    label => 'sufr',
    desc  => 'sufr builds the suffix array ltr-forage searches. (0.8.0 or '
           . 'higher)',
    url   => 'https://github.com/TravisWheelerLab/sufr',
    version_check => sub { _check_version( 'SUFR_DIR', 'sufr', '0.8.0' ) },
  );
}

##
## Die unless the program configured under $key is at least version $min.
##
sub _check_version {
  my ( $key, $label, $min ) = @_;
  my $ver = RepModelConfig::getDependencyVersion($key) // "";
  my @v = split( /\./, $ver );
  my @m = split( /\./, $min );
  my $cmp = 0;
  for my $i ( 0 .. 2 ) {
    $cmp = ( $v[$i] // -1 ) <=> $m[$i];
    last if $cmp;
  }
  if ( $cmp < 0 ) {
    die "\n  ERROR: $label " . ( $ver || "of unknown version" )
      . " is too old; $min or higher is required.\n\n";
  }
  status_info("Version: $ver");
}

