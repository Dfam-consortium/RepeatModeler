## Configure dfam-curator (required).
##
sub configure_dfam_curator {
  _configure_dir(
    key   => 'DFAM_CURATOR_DIR',
    label => 'dfam-curator',
    desc  => 'dfam-curator\'s te-composer builds and extends the consensus for '
           . 'each family, in place of the Refiner script RepeatModeler once '
           . 'ran. (0.6.6 or higher)',
    url   => 'https://github.com/Dfam-consortium/dfam-curator',
    version_check => sub { _check_version( 'DFAM_CURATOR_DIR', 'dfam-curator', '0.6.6' ) },
